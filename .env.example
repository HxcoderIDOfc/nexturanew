PORT=8000
HOST=0.0.0.0

# Admin panel: /plugins dan /console
WA_ADMIN_KEY=ganti-dengan-key-admin-yang-kuat

# WhatsApp
WA_AUTO_READ=true
WA_AI_AUTO_REPLY=true
WA_SESSION_DIR=/data/nextura-wa-session
WA_PLUGIN_RELOAD_MS=5000
WA_CONSOLE_MAX_LOGS=500

# Opsional: jika plugin juga ingin disimpan di persistent volume
# WA_PLUGIN_DIR=/data/wa-plugins

# Nera AI
NERA_AI_BASE_URL=https://api.axynera.my.id
NERA_AI_MODEL=Nera-Plus.5
NERA_AI_DEFAULT_MODE=cepat
NERA_AI_TIMEOUT_MS=120000

# Opsional jika API Nera nanti memakai Authorization Bearer
NERA_AI_API_KEY=

# Memory Nera per user/LID. 20 turn = maksimal 40 pesan user+assistant.
NERA_AI_MEMORY_TURNS=20

# Default tersimpan bersama WA_SESSION_DIR agar ikut persistent volume.
# NERA_AI_MEMORY_FILE=/data/nextura-wa-session/nera-memory.json

BODY_LIMIT_BYTES=2097152
KEEP_ALIVE_TIMEOUT_MS=75000
