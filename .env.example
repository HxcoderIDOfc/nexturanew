# Koyeb otomatis menyediakan PORT. Nilai 8000 dipakai untuk lokal/Docker.
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# API key publik yang dipakai client Nextura
NEXTURA_API_KEY=ganti-dengan-key-nextura

# Gonka
GONKA_API_KEY=ganti-dengan-key-gonka
GONKA_BASE_URL=https://gate.joingonka.ai
GONKA_MODEL=MiniMaxAI/MiniMax-M2.7

# CometAPI
COMET_API_KEY=ganti-dengan-key-cometapi
COMET_BASE_URL=https://api.cometapi.com/v1
COMET_MODEL=gpt-5-nano-2025-08-07

# Agent Search dan Deep Thinking
ENABLE_AGENT_SEARCH=true
ENABLE_DEEP_THINKING=true
SEARCH_MAX_TOKENS=1800
MAX_OUTPUT_TOKENS=8192

# Server protection dan koneksi panjang
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=600000
UPSTREAM_TIMEOUT_MS=540000
KEEP_ALIVE_TIMEOUT_MS=75000
BODY_LIMIT_BYTES=10485760
SSE_HEARTBEAT_MS=15000
