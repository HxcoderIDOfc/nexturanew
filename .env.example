PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

NEXTURA_API_KEY=change-me
NEXTURA_AI_NAME=Cortexa Max
NEXTURA_MODEL_FAMILY=Nextura Cortexa
NEXTURA_DEVELOPER=Nextura
NEXTURA_COMPANY=Nextura
NEXTURA_DEFAULT_LANGUAGE=Bahasa Indonesia
NEXTURA_MAX_MODEL_ID=Nextura/cortexa-max
NEXTURA_MAX_MODEL_NAME=Nextura Cortexa Max

# Lokasi publik Nextura AI.
# Jika NEXTURA_DEVELOPER_LOCATION kosong, startup akan reverse-geocode LAT/LNG sekali lalu menyimpan nama lokasi ke env runtime.
NEXTURA_DEVELOPER_LOCATION=
NEXTURA_LOCATION_LAT=-6.8443892
NEXTURA_LOCATION_LNG=108.7638626
NEXTURA_LOCATION_FALLBACK=Jawa Barat, Indonesia
NEXTURA_LOCATION_TIMEOUT_MS=8000

GONKA_API_KEY=change-me
GONKA_BASE_URL=https://gate.joingonka.ai
GONKA_MODEL=MiniMaxAI/MiniMax-M2.7

COMET_API_KEY=change-me
COMET_BASE_URL=https://api.cometapi.com/v1
COMET_MODEL=gpt-5-nano-2025-08-07

# Adaptive Nextura Cortexa Max Engine
ENABLE_MAX_ENGINE=true
MAX_CORE_PORT=8005
ENABLE_AGENT_SEARCH=true
ENABLE_IDENTITY_ENFORCEMENT=true
NEXTURA_THINKING_LEVEL=cepat
SEARCH_MAX_TOKENS=1800
MAX_OUTPUT_TOKENS=8192
THINKING_REVIEW_MAX_TOKENS=4096

# Nextura Sandbox Terminal + artifact tools
ENABLE_TERMINAL_TOOL=true
NEXTURA_TOOL_KEY=change-with-a-long-random-secret
TOOL_WORKSPACE_ROOT=.
TOOL_SANDBOX_ROOT=/tmp/nextura-sandbox
TOOL_COMMAND_TIMEOUT_MS=120000
TOOL_MAX_OUTPUT_BYTES=20000
TOOL_MAX_FILE_BYTES=512000
TOOL_MAX_DOWNLOAD_BYTES=10485760
TOOL_MAX_PDF_CHARS=120000
TOOL_SCREENSHOT_TIMEOUT_MS=45000
CHROMIUM_PATH=/usr/bin/chromium-browser
TERMINAL_AGENT_MAX_ACTIONS=6
NEXTURA_GATEWAY_PORT=8010

# Untuk deploy Cloudflare non-interaktif
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=600000
UPSTREAM_TIMEOUT_MS=540000
KEEP_ALIVE_TIMEOUT_MS=75000
BODY_LIMIT_BYTES=10485760
SSE_HEARTBEAT_MS=15000
