PORT=8000
HOST=0.0.0.0

# Admin panel: /plugins dan /console
WA_ADMIN_KEY=ganti-dengan-key-admin-yang-kuat

# WhatsApp
WA_AUTO_READ=true
WA_SESSION_DIR=/data/nextura-wa-session
WA_PLUGIN_RELOAD_MS=5000
WA_CONSOLE_MAX_LOGS=500

# Opsional: jika plugin juga ingin disimpan di persistent volume
# WA_PLUGIN_DIR=/data/wa-plugins

# Nextura AI
NEXTURA_AI_BASE_URL=https://api.nextura.my.id
NEXTURA_AI_API_KEY=isi-api-key-nextura-di-env

# Opsional. Jika kosong, bot otomatis membaca /v1/models dan memilih model yang tersedia.
NEXTURA_AI_MODEL=
NEXTURA_AI_TIMEOUT_MS=120000

BODY_LIMIT_BYTES=2097152
KEEP_ALIVE_TIMEOUT_MS=75000
