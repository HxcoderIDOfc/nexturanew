PORT=8000
HOST=0.0.0.0

# Kunci untuk membuka /plugins dan API editor plugin.
WA_ADMIN_KEY=ganti-dengan-key-admin-yang-kuat

# Gunakan persistent volume agar session WhatsApp tidak hilang saat restart/redeploy.
WA_SESSION_DIR=/data/nextura-wa-session

# Opsional: simpan plugin hasil upload/edit ke persistent volume juga.
# WA_PLUGIN_DIR=/data/wa-plugins
WA_PLUGIN_RELOAD_MS=5000

# Nextura AI Chat dari nextura.my.id
# Bot merespons perintah: .ai pesan kamu
NEXTURA_AI_BASE_URL=https://nextura.my.id
NEXTURA_AI_API_KEY=isi-api-key-nextura-di-env
NEXTURA_AI_MODEL=Nextura/cortexa-nexus2.7
NEXTURA_AI_TIMEOUT_MS=120000

# HTTP runtime
BODY_LIMIT_BYTES=2097152
KEEP_ALIVE_TIMEOUT_MS=75000
